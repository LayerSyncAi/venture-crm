new file mode 100644
index 0000000..d248015
--- /dev/null
+++ b/docs/venture.env.example
@@ -0,0 +1,53 @@
+# ─────────────────────────────────────────────────────────────────────────────
+# Venture Management branding — paste into .env.local AND into Vercel →
+# Settings → Environment Variables (Production + Preview). Rebuild after changes.
+# Colours from the Venture Management brand board (demou DESIGN).
+# ─────────────────────────────────────────────────────────────────────────────
+
+# Identity
+NEXT_PUBLIC_BRAND_NAME="Venture Management"
+NEXT_PUBLIC_BRAND_LEGAL_NAME="Venture Management"
+NEXT_PUBLIC_BRAND_TAGLINE="REPLACE with Venture Management's tagline"
+NEXT_PUBLIC_BRAND_DESCRIPTION="Leads, lettings, valuations and finance for Venture Management, on one login"
+NEXT_PUBLIC_BRAND_APP_DOMAIN="crm.venturemanagement.com"
+
+# Contact (fill in)
+NEXT_PUBLIC_BRAND_CONTACT_EMAIL=""
+NEXT_PUBLIC_BRAND_CONTACT_PHONE=""
+NEXT_PUBLIC_BRAND_CONTACT_ADDRESS=""
+
+# Colours
+# Accent = brand orange #E5A04B, with deep navy text on it (7.3:1 contrast).
+NEXT_PUBLIC_BRAND_COLOR_PRIMARY="#E5A04B"
+NEXT_PUBLIC_BRAND_COLOR_PRIMARY_600="#C9852E"
+NEXT_PUBLIC_BRAND_COLOR_PRIMARY_FG="#001F4D"
+# Orange is too light for text on white, so links/active labels use a dark orange.
+NEXT_PUBLIC_BRAND_COLOR_PRIMARY_INK="#8A5410"
+# Sidebar = brand deep navy #001F4D, hover = brand navy #315469, cream text.
+NEXT_PUBLIC_BRAND_COLOR_SIDEBAR="#001F4D"
+NEXT_PUBLIC_BRAND_COLOR_SIDEBAR_HOVER="#315469"
+NEXT_PUBLIC_BRAND_COLOR_SIDEBAR_FG="#F8F0E6"
+# App background = brand cream #F8F0E6; body text = deep navy.
+NEXT_PUBLIC_BRAND_COLOR_BACKGROUND="#F8F0E6"
+NEXT_PUBLIC_BRAND_COLOR_FOREGROUND="#001F4D"
+# Status colours: darker shades of brand green #3FBA90 and blue #4E86A6 so text
+# stays readable (the swatch colours themselves fail contrast as text).
+NEXT_PUBLIC_BRAND_COLOR_SUCCESS="#1E7A5A"
+NEXT_PUBLIC_BRAND_COLOR_WARNING="#9A4A07"
+NEXT_PUBLIC_BRAND_COLOR_DANGER="#C2261B"
+NEXT_PUBLIC_BRAND_COLOR_INFO="#2F6485"
+
+# Logos (files are in public/brand/ — these are the defaults, listed for clarity)
+NEXT_PUBLIC_BRAND_LOGO_FAVICON="/brand/favicon-32x32.png"
+NEXT_PUBLIC_BRAND_LOGO_ICON="/brand/icon-192x192.png"
+NEXT_PUBLIC_BRAND_LOGO_APPLE="/brand/apple-touch-icon.png"
+NEXT_PUBLIC_BRAND_LOGO_WORDMARK="/brand/wordmark.png"
+NEXT_PUBLIC_BRAND_LOGO_OG="/brand/og.png"
+NEXT_PUBLIC_BRAND_LOGO_LOCKUP="/brand/lockup.svg"
+NEXT_PUBLIC_BRAND_LOGO_REVERSED="/brand/lockup-reversed.svg"
+NEXT_PUBLIC_BRAND_LOGO_MARK="/brand/mark.svg"
+NEXT_PUBLIC_BRAND_LOGO_APP_ICON="/brand/app-icon-dark.svg"
+
+# Not used by Venture (LayerSync's own website analytics) — leave empty.
+NEXT_PUBLIC_SYNCSITE_URL=
+NEXT_PUBLIC_SYNCSITE_KEY=
